<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <!-- Point at another checkout to compare versions: dotnet run -c Release -p:OpenSheetProject=<path>\OpenSheet.csproj -->
    <OpenSheetProject Condition="'$(OpenSheetProject)' == ''">$(MSBuildThisFileDirectory)..\..\src\OpenSheet\OpenSheet.csproj</OpenSheetProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(OpenSheetProject)" />
  </ItemGroup>

</Project>
